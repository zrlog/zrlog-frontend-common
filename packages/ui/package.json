{
  "name": "@zrlog/ui",
  "version": "0.1.0",
  "description": "Shared ZrLog themes and presentation for React applications using Ant Design",
  "license": "Apache-2.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "themes.js",
    "material.js"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc --project tsconfig.json && tsc --project tsconfig.json --module ESNext --outDir dist/esm --declaration false && node ../../scripts/esm.mjs packages/ui/dist/esm",
    "test": "node --test test/*.test.cjs"
  },
  "dependencies": {
    "@ant-design/fast-color": "3.0.1",
    "antd-style": "4.1.0",
    "clsx": "2.1.1"
  },
  "peerDependencies": {
    "antd": "6.4.x",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "antd": "6.4.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "5.8.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/zrlog/zrlog-frontend-common.git",
    "directory": "packages/ui"
  },
  "module": "dist/esm/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/index.js"
    },
    "./themes": {
      "types": "./dist/themes.d.ts",
      "import": "./dist/esm/themes.js",
      "require": "./dist/themes.js"
    },
    "./material": {
      "types": "./dist/material.d.ts",
      "import": "./dist/esm/material.js",
      "require": "./dist/material.js"
    }
  },
  "typesVersions": {
    "*": {
      "themes": [
        "dist/themes.d.ts"
      ],
      "material": [
        "dist/material.d.ts"
      ]
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
